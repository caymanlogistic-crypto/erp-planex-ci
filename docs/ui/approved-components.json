  "components": [
    {
      "id": "registry.page-head",
      "family": "registry",
      "role": "Шапка страницы",
      "selector": ".registry-ui-head",
      "markup": "app/View/partials/registry_ui_head.php",
      "approval": "OWNER 2026-10-12",
      "description": "Отдельная шапка с иконкой, заголовком, пояснением и действиями справа. Новая страница использует общий PHP partial.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.tabs",
      "family": "registry",
      "role": "Вкладки статусов",
      "selector": ".registry-ui-tabs",
      "approval": "OWNER 2026-10-12",
      "description": "Плоские вкладки со счётчиками и линией активного статуса; на узком экране прокручиваются внутри своей строки.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.card",
      "family": "registry",
      "role": "Рамка рабочего блока",
      "selector": ".registry-ui-card",
      "approval": "OWNER 2026-10-12",
      "description": "Единая непрерывная рамка вокруг панели и таблицы. Шапка страницы находится отдельно.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.toolbar",
      "family": "registry",
      "role": "Панель Найдено и фильтров",
      "selector": ".registry-ui-toolbar",
      "approval": "OWNER 2026-10-12",
      "description": "Панель внутри рамки: слева счётчик и при наличии флажок через штатный разделитель, справа сначала «Сбросить фильтр», затем фильтры, поиск последним. Высота растёт вместе с содержимым; появление сброса не сдвигает контролы.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.search",
      "family": "registry",
      "role": "Поиск",
      "selector": ".registry-ui-search",
      "approval": "OWNER 2026-10-18",
      "description": "IBM Plex Sans 12/500/16; отступ слева 31 px, постоянная иконка при focus. Поиск последний справа; «Сбросить фильтр» расположен перед фильтрами и появляется при изменении состояния.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.table",
      "family": "registry",
      "role": "Таблица и заголовки",
      "selector": ".registry-ui-table",
      "approval": "OWNER 2026-10-12",
      "description": "Таблица с утверждёнными типографикой, фоном строк и заголовком. Колонки и предметные данные задаёт страница.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.sticky",
      "family": "registry",
      "role": "Закрепление панели и заголовков",
      "selector": ".registry-ui-sticky-table",
      "approval": "OWNER 2026-10-12",
      "description": "Opt-in для закрепления панели и заголовков. Общий JS измеряет реальную высоту панели.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.select",
      "family": "registry",
      "role": "Выбор значения",
      "selector": ".registry-ui-toolbar .lab-reference-select",
      "approval": "OWNER 2026-10-12; colors OWNER 2026-10-24, decisions-20261024-select-colors.json",
      "description": "Светлый закрытый select #FFFDF9 с рамкой #C8C0B5 и текстом #2E2923 в тон поиску; hover и pressed #F9F7F2 с рамкой #A8A196. Белый список сохраняет геометрию; выбранный пункт #F0EDE7, при наведении #EAE3D8. Управление клавиатурой и native select сохранены.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.actions",
      "family": "registry",
      "role": "Кнопки шапки",
      "selector": ".registry-ui-head .page-head-actions .btn",
      "approval": "OWNER 2026-10-12",
      "description": "Вторичные действия идут перед одним главным. Общий компонент задаёт размер, цвет, hover и focus.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.checkbox",
      "family": "registry",
      "role": "Флажок панели",
      "selector": ".registry-ui-checkbox",
      "approval": "OWNER 2026-10-12; toolbar placement OWNER 2026-10-23",
      "description": "Существующий общий класс для одиночного native checkbox с кликабельной подписью, без отдельной плашки. Если флажок предусмотрен страницей, он расположен слева после счётчика и существующего .filter-sep; без флажка разделителя нет. Исторический .rp-v014-hide-complete не использовать как образец новой страницы.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.finance-table",
      "family": "registry",
      "role": "Финансовая таблица",
      "selector": ".registry-ui-table--finance",
      "approval": "OWNER 2026-10-12",
      "description": "Утверждённый вариант таблицы для широкой финансовой записи. Состав колонок и итоги задаёт страница.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.checkbox-group",
      "family": "registry",
      "role": "Блок флажков",
      "selector": ".registry-ui-checkboxes",
      "approval": "OWNER 2026-10-18",
      "description": "Группа и одиночный флажок панели используют одно правило размеров, текста и фокуса; обычный акцент коричневый. Только блок статусов рейсов с явным вариантом registry-ui-checkboxes--trip-status использует смысловые цвета. Native input сохраняет клавиатуру и доступное имя.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.data",
      "family": "registry",
      "role": "Типографика данных",
      "selector": ".registry-ui-data",
      "approval": "OWNER 2026-10-18",
      "description": "Основной 12/500/16.8; имена и суммы 12/600; дополнительный 11/500/15.4. IBM Plex Sans.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.id",
      "family": "registry",
      "role": "ID любой сущности",
      "selector": ".registry-ui-id",
      "approval": "OWNER 2026-10-18",
      "description": "Общая колонка 64 px для #0000; настоящий ID не сокращается и не дополняется нулями.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.trip",
      "family": "registry",
      "role": "Описание рейса",
      "selector": ".registry-ui-trip",
      "approval": "OWNER 2026-10-18",
      "description": "Колонка 240 px, 30 графем и …; полное значение доступно для чтения и поиска.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.secondary",
      "family": "registry",
      "role": "Дополнительные данные",
      "selector": ".registry-ui-secondary",
      "approval": "OWNER 2026-10-18",
      "description": "Дата счёта, водитель под перевозчиком, пояснения, контакты: 11/500/15.4.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.palette",
      "family": "registry",
      "role": "Смысловые цвета",
      "selector": ".registry-ui-warning",
      "approval": "OWNER 2026-10-18",
      "description": "Согласованные жёлтый/чёрный, красный, мягкие красный и зелёный; hover без изменения геометрии.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.status",
      "family": "registry",
      "role": "Предметные статусы",
      "selector": ".registry-ui-status",
      "approval": "OWNER 2026-10-18",
      "description": "Выезды: фиолетовый, бирюзовый, зелёный, серый. Документы: Есть/НЕТ, несколько ТС, оплата и комплектность.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.state",
      "family": "registry",
      "role": "Фильтры, память и сброс",
      "selector": ".registry-ui-reset",
      "approval": "OWNER 2026-10-18",
      "description": "Одна кнопка «Сбросить фильтр» первой в правой группе при любом отклонении от начальных значений. Состояние отдельно по странице, пользователю, роли и компании; select и поиск не сдвигаются при появлении кнопки.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.scroll",
      "family": "registry",
      "role": "Прокрутка таблицы",
      "selector": ".registry-ui-scroll",
      "approval": "OWNER 2026-10-18",
      "description": "Один вертикальный владелец, панель и заголовки закреплены вместе, горизонтальная прокрутка широкого содержимого.",
      "specimen": "docs/ui/specimens/registry.composition.html"
    },
    {
      "id": "registry.placement-blocks",
      "family": "registry",
      "role": "Блоки размещения ФЭО",
      "selector": ".registry-ui-table--placement-blocks",
      "approval": "OWNER 2026-10-20; feo-map-appearance-lab-20261020:v006; docs/ui/decisions-20261020-feo-placement-appearance.json",
      "description": "Opt-in таблица с нейтральной отключённой строкой, цветом и весом операции, естественным переносом цельных ID источника и согласованной сводкой вторичного поиска. Предметные ширины колонок задаёт FEO view.",
      "specimen": "docs/ui/specimens/registry.placement-blocks.html"
    },
    {
      "id": "registry.inline-identity",
      "family": "registry",
      "role": "ID и название в одной строке",
      "selector": ".registry-ui-inline-identity",
      "approval": "OWNER2026-10-20: secondary FEO search ID and name in one line; docs/ui/decisions-20261020-feo-search.json",
      "description": "Одна строка из неизменного ID и названия с существующими primary/name ролями; длинное имя сокращается с полным title. Во вторичном поиске ФЭО тип стоит второй колонкой, все строки используют общий жёлтый warning, заголовок не наследует sticky основной таблицы.",
      "specimen": "docs/ui/specimens/registry.inline-identity.html"
    },
    {
      "id": "registry.modal",
      "family": "registry",
      "role": "Компактный попап реестра",
      "selector": ".registry-ui-modal",
      "approval": "OWNER 2026-10-24; docs/ui/decisions-20261024-feo-transfer-popups.json",
      "description": "Общая opt-in оболочка согласованных попапов: шапка 19/700, тело 12/16, футер с семантическими кнопками; вложенные формы и текстовые представления используют одни классы и сетку.",
      "specimen": "docs/ui/specimens/registry.transfer-popup.html"
    },
    {
      "id": "registry.modal-reading",
      "family": "registry",
      "role": "Компактная ширина текстовой истории",
      "selector": ".registry-ui-modal--reading",
      "approval": "OWNER 2026-10-24: reduce empty space in transfer history; docs/ui/decisions-20261024-feo-transfer-popups.json",
      "description": "Общий opt-in вариант оболочки для подробного просмотра: максимум 900 px. Двухгрупповая desktop-сетка и одноколоночная mobile-сетка используют общую роль registry-ui-modal-grid--reading; таблица занимает всю ширину, полный текст сохраняется.",
      "specimen": "docs/ui/specimens/registry.transfer-popup.html"
    },
    {
      "id": "registry.modal-confirmation",
      "family": "registry",
      "role": "Компактная ширина окончательного подтверждения",
      "selector": ".registry-ui-modal--confirmation",
      "approval": "OWNER 2026-10-24: reduce empty space in transfer confirmation; docs/ui/decisions-20261024-feo-transfer-popups.json",
      "description": "Общий opt-in вариант оболочки для короткого подтверждения: максимум 640 px. При длинном списке номеров тело прокручивается по высоте; состав и цвет кнопок задаёт утверждённый предметный сценарий.",
      "specimen": "docs/ui/specimens/registry.transfer-confirmation.html"
    },
    {
      "id": "registry.modal-reading-grid",
      "family": "registry",
      "role": "Две группы данных в истории переноса",
      "selector": ".registry-ui-modal-grid--reading",
      "approval": "OWNER 2026-10-24/25: docs/ui/decisions-20261025-feo-transfer-v007.json",
      "description": "На desktop слева только полные номера под общей .page-eyebrow ЗАЯВКИ, справа .page-eyebrow ПЕРЕМЕЩЕНЫ ПО АДРЕСУ и полный адрес; таблица занимает всю ширину. До 700 px группы идут одной колонкой. Текст, координаты и качество используют существующие registry-ui-modal-text/geo/quality роли.",
      "specimen": "docs/ui/specimens/registry.transfer-popup.html"
    },
    {
      "id": "registry.compact-table",
      "family": "registry",
      "role": "Таблица внутри попапа",
      "selector": ".registry-ui-compact-table",
      "approval": "OWNER 2026-10-24; docs/ui/decisions-20261024-feo-transfer-popups.json",
      "description": "Таблица с системной внешней обводкой, заголовком и внутренней прокруткой до 300 px. Заголовки и ячейки: 8 px сверху/снизу и 10 px сбоку, высота по содержимому; перед таблицей 8 px, до футера 12 px. Ячейки каждой строки начинаются на одном верхнем уровне. Предметные колонки определяет попап: при предпросмотре переноса Заявка, Вес нетто, Было, Станет; в истории выполненного переноса Заявка, Вес нетто, Было, Стало.",
      "specimen": "docs/ui/specimens/registry.transfer-popup.html"
    },
    {
      "id": "registry.entity-id",
      "family": "registry",
      "role": "Номер заявки в попапе",
      "selector": ".registry-ui-entity-id",
      "approval": "OWNER 2026-10-24; docs/ui/decisions-20261024-feo-transfer-popups.json",
      "description": "IBM Plex Sans 12/700, #131210, табличные цифры; все номера заявок показываются целиком и переносятся по границам номеров.",
      "specimen": "docs/ui/specimens/registry.transfer-popup.html"
    },
    {
      "id": "notifications.toast",
      "family": "notifications",
      "role": "Системное временное уведомление",
      "selector": ".toast--system",
      "approval": "OWNER 2026-10-25; notification-center-design-20261025:v003; docs/ui/decisions-20261025-notification-center.json; OWNER 2026-10-26; docs/ui/decisions-20261026-notification-top-center.json",
      "description": "Цветная карточка выезжает сверху по центру экрана, с системными зелёной/жёлтой/красной заливками, чёрным текстом и контуром, без обводки знака; одно сообщение на 5 секунд, FIFO-очередь, крестик и доступные роли.",
      "specimen": "docs/ui/specimens/notifications.toast.html"
    }
  ],
