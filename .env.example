APP_NAME=ERP PLANEX
APP_ENV=local
# Enable only after controlled migration/parity marks every target company ready.
ERP_ROLES_ACCESS_ENABLED=false
APP_DEBUG=true
APP_BASE_PATH=
# Только для локальной первичной разработки. Никогда не включать в production.
APP_ALLOW_DEV_SEED=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_planex
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# COMPANY_DB_POOL_JSON — JSON-массив предсозданных БД для новых экспедиторов.
# Формат: [{"database":"erp_pool_1","username":"pool_user_1","password":"...","host":"optional","port":"optional"}]
# Если не задан или пуст — используется CREATE DATABASE.
# COMPANY_DB_POOL_JSON=

# BANK_IMAP — настройки для автоматического импорта банковских выписок
# BANK_IMAP_HOST=imap.spaceweb.ru
# BANK_IMAP_PORT=993
# BANK_IMAP_SSL=1
# BANK_IMAP_USERNAME=info@plan-ex.ru
# BANK_IMAP_PASSWORD=
# BANK_IMAP_FROM=vtb-inform@vtb.ru
# BANK_IMAP_SUBJECT_CONTAINS=Регулярная выписка
# Необязательно: разрешённые публичные IMAP-хосты через запятую.
# BANK_IMAP_ALLOWED_HOSTS=imap.spaceweb.ru
# BANK_IMPORT_COMPANY_ID=

# APP_ENCRYPTION_KEY — ключ для аутентифицированного шифрования секретов (AES-256-GCM).
# Используется для шифрования паролей IMAP-почтовых ящиков и других sensitive данных.
# Сгенерируйте: php -r "echo bin2hex(random_bytes(32));"
# APP_ENCRYPTION_KEY=

DADATA_API_KEY=
DADATA_API_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/findById/party
DADATA_API_TIMEOUT=5
DADATA_CAINFO=

# Yandex Maps JavaScript API 2.1. Значение хранится только в runtime environment, не в git.
YANDEX_MAPS_API_KEY=

# LEGACY_FLIGHTS_DB_* — read-only источник старых flights для ручного импорта в /company/trips/departures/import.
# В production используйте отдельного MySQL пользователя только с SELECT на legacy flights/feo/contractors/drivers/users.
# LEGACY_FLIGHTS_DB_HOST=127.0.0.1
# LEGACY_FLIGHTS_DB_PORT=3306
# LEGACY_FLIGHTS_DB_DATABASE=
# LEGACY_FLIGHTS_DB_USERNAME=
# LEGACY_FLIGHTS_DB_PASSWORD=
# LEGACY_FLIGHTS_DB_CHARSET=utf8mb4

# FEO import mirror: explicit single-tenant binding. Shared PDO or separate-account XA.
# The chosen legacy user requires SELECT/INSERT/UPDATE/DELETE and TRIGGER (inspection).
# No credentials from LEGACY_FLIGHTS_DB_* are reused for writes. No runtime DDL or migrations.
# FEO_LEGACY_SYNC_TENANT_DATABASE=
# FEO_LEGACY_SYNC_DATABASE=

# Protected base64 JSON with host, port, username, password; configure via guarded workflow.
# FEO_LEGACY_SYNC_CONNECTION_B64=
# Durable XA journal outside web root; must survive deployments and crashes.
# FEO_LEGACY_SYNC_JOURNAL_DIR=
