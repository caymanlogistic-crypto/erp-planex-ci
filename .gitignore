# Environment
.env
.env.*
!.env.example

# Storage (keep .gitkeep)
/storage/*
!/storage/.gitkeep

# Logs (keep .gitkeep)
/logs/*
!/logs/.gitkeep

# Dependencies
/vendor/
/node_modules/
/.kilo/

# Build / cache
/cache/
/tmp/
/temp/
*.cache
__pycache__/
*.py[cod]

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS files (Windows / macOS)
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
Icon

# Database dumps
*.sql
*.sql.gz
*.dump

# Database migrations (tracked)
!database/migrations/*.sql
!database/migrations-local/*.sql
!database/migrations-legacy/*.sql

# Archives
*.zip
*.tar
*.tar.gz
*.rar
*.7z
